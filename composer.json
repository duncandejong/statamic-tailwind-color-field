{
    "name": "dtaildesign/statamic-tailwind-color-field",
    "description": "Choose predefined Tailwind CSS colors in Statamic blueprints.",
    "homepage": "https://github.com/duncandejong/statamic-tailwind-color-field",
    "license": "MIT",
    "authors": [
        {
            "name": "DTAIL Design",
            "homepage": "https://github.com/duncandejong"
        }
    ],
    "support": {
        "issues": "https://github.com/duncandejong/statamic-tailwind-color-field/issues",
        "source": "https://github.com/duncandejong/statamic-tailwind-color-field"
    },
    "autoload": {
        "psr-4": {
            "DtailDesign\\StatamicTailwindColorField\\": "src"
        }
    },
    "extra": {
        "statamic": {
            "name": "Tailwind Color Field",
            "description": "Choose predefined Tailwind CSS colors in Statamic blueprints.",
            "developer": "DTAIL Design",
            "developer-url": "https://github.com/duncandejong"
        },
        "laravel": {
            "providers": [
                "DtailDesign\\StatamicTailwindColorField\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "pixelfear/composer-dist-plugin": "^0.1.6"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    }
}
